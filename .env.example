# Supabase
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to 'true' to require sign-in + admin approval to use the app (see
# supabase/auth-approved-lockdown.sql for the full flip checklist).
VITE_REQUIRE_AUTH=false

# SSO portal callback (api/portal-callback.ts — the portal redirects to
# https://ranking-reports-alpha.vercel.app/api/portal-callback?token=...).
# Server-only — set these in Vercel (Production), never with a VITE_ prefix.
# SUPABASE_URL is optional: when unset the function falls back to the existing
# VITE_SUPABASE_URL above (server-side process.env access ignores the VITE_
# prefix — that only governs Vite's client-bundle inlining). APP_URL is the
# canonical app origin used for redirects; when unset the request host is used.
# PORTAL_JWKS_URL=https://dashboard-portal-tawny.vercel.app/api/sso/jwks
# PORTAL_ISSUER=https://dashboard-portal-tawny.vercel.app
# SSO_AUDIENCE=3b3a26b1-c89d-4d2f-ba2e-d88f743f062d
# SUPABASE_URL=your-project-url
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# APP_URL=https://ranking-reports-alpha.vercel.app

# Ranks API (api/sites.ts — the "Sync from API" button on BP Sites).
# Server-only: must NEVER get a VITE_ prefix, or the key ships in the public
# bundle. Set it in Vercel for Production and Preview, and in .env locally —
# vite.config.ts loads it for the dev server.
SITES_API_KEY=bpn_your_key

# /api/sites is NOT public: it verifies the caller's Supabase access token
# server-side (api/_lib/requestAuth.ts) before proxying, so it needs the
# project URL and the ANON key on the server. Both are optional here — when
# unset they fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above,
# which Vercel already has for the client build, so no extra Vercel config is
# required. Server-only if you do set them: never add a VITE_ prefix to these
# names. The service-role key is deliberately NOT used on this path — token
# verification needs no elevated privilege.
# SUPABASE_ANON_KEY=your-anon-key
